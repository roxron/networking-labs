        <mxCell id="ospf-heading" value="&lt;b&gt;ISP100 OSPF IGP&lt;/b&gt;&lt;br&gt;OSPFv2 process 100 | Backbone area 0&lt;br&gt;16 routers | 30 point-to-point links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;align=left;verticalAlign=top;spacing=18;fontSize=21;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="80" y="65" width="570" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ospf-policy" value="&lt;b&gt;OSPF process and routing context&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;P1–P12&lt;/b&gt;&lt;br&gt;router ospf 100 vrf ISP100&lt;br&gt;capability vrf-lite&lt;br&gt;&lt;br&gt;&lt;b&gt;ISP100-PE13–PE16&lt;/b&gt;&lt;br&gt;router ospf 100&lt;br&gt;Global routing table (GRT)&lt;br&gt;&lt;br&gt;Router IDs are Loopback100 IPv4 addresses.&lt;br&gt;Loopback100 /32 prefixes are advertised in area 0.&lt;br&gt;Loopbacks are passive; no adjacency on Lo100." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2240" y="250" width="540" height="365" as="geometry" />
        </mxCell>
        <mxCell id="ospf-link-policy" value="&lt;b&gt;All 30 /30 links (P–P and PE–P)&lt;/b&gt;&lt;br&gt;&lt;br&gt;ip ospf 100 area 0&lt;br&gt;ip ospf network point-to-point&lt;br&gt;&lt;br&gt;All 60 link interfaces actively form adjacencies.&lt;br&gt;No DR/BDR election; no Type 2 LSA originated&lt;br&gt;for these links. Link topology and /30 prefixes&lt;br&gt;are represented in Type 1 Router LSAs.&lt;br&gt;&lt;br&gt;All numbered link labels marked P2P use this mode.&lt;br&gt;Unnumbered parent interfaces do not run OSPF." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2240" y="645" width="540" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ospf-metric-policy" value="&lt;b&gt;Metrics and passive-interface policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;auto-cost reference-bandwidth 1000&lt;br&gt;Reference bandwidth: 1000 Mbps&lt;br&gt;1-Gbps links: calculated cost 1&lt;br&gt;(assuming the default 1-Gbps interface bandwidth)&lt;br&gt;&lt;br&gt;passive-interface default&lt;br&gt;no passive-interface &amp;lt;each numbered link&amp;gt;&lt;br&gt;&lt;br&gt;No redistribution or OSPF authentication configured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2240" y="1005" width="540" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
