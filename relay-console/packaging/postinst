#!/bin/sh
set -eu
if ! getent group relay-console >/dev/null; then groupadd --system relay-console; fi
if ! getent passwd relay-console >/dev/null; then useradd --system --gid relay-console --home-dir /var/lib/relay-console --shell /usr/sbin/nologin relay-console; fi
install -d -m 0750 -o relay-console -g relay-console /var/lib/relay-console /var/lib/relay-console/data /var/lib/relay-console/certs
key=/var/lib/relay-console/certs/relay-console-key.pem
cert=/var/lib/relay-console/certs/relay-console-cert.pem
if [ ! -s "$key" ] || [ ! -s "$cert" ]; then
  host_name=$(hostname -f 2>/dev/null || hostname)
  sans="DNS:localhost,DNS:${host_name},IP:127.0.0.1"
  for ip_address in $(hostname -I 2>/dev/null || true); do sans="${sans},IP:${ip_address}"; done
  openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 10000 -keyout "$key" -out "$cert" -subj "/CN=${host_name}" -addext "subjectAltName=${sans}" -addext 'keyUsage=digitalSignature,keyEncipherment' -addext 'extendedKeyUsage=serverAuth'
  chmod 0600 "$key"
  chmod 0644 "$cert"
fi
chown -R relay-console:relay-console /var/lib/relay-console
systemctl daemon-reload
systemctl enable relay-console.service >/dev/null
if systemctl is-active --quiet relay-console.service; then systemctl restart relay-console.service; else systemctl start relay-console.service; fi
echo "Relay Console is available at https://$(hostname -I 2>/dev/null | awk '{print $1}'):3000/"
